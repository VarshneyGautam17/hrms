## Copy this file to .env.local (same folder) and fill in your own Firebase
## project's values — find them in Firebase Console → Project Settings →
## General → "Your apps" → the web app's config snippet.
##
## .env.local is already in .gitignore (matched by the *.local rule) — never
## commit your real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
