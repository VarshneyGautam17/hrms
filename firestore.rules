rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
// Every document lives under users/{uid}/... and only the signed-in user
// matching that uid can read or write their own data. Nobody else — not
// even another signed-in account — can see it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
